        </label>
      </div>

      <div class="tabs-nav">
        <% flows_data.each_with_index do |flow, f_idx| %>
          <button class="tab-btn <%= 'active' if f_idx == 0 %>" 
                  id="tab-btn-<%= flow[:id] %>" 
                  data-flow-id="<%= flow[:id] %>"
                  onclick="switchTab('<%= flow[:id] %>')">
            <span><%= CGI.escapeHTML(flow[:name]) %></span>
            <span class="tab-badge" id="tab-badge-<%= flow[:id] %>" style="display: none;">0</span>
          </button>
        <% end %>
      </div>

      <% flows_data.each_with_index do |flow, f_idx| %>
        <div id="panel-<%= flow[:id] %>" 
             class="tab-panel <%= 'active' if f_idx == 0 %>" 
             data-flow-id="<%= flow[:id] %>" 
             data-flow-name="<%= CGI.escapeHTML(flow[:name]) %>">
          <table>
            <thead>
              <tr>
                <th>Module</th>
                <% (0...flow[:stages].length-1).each do |i| %>
                  <th><%= flow[:stages][i] %> &rarr; <%= flow[:stages][i+1] %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% flow[:modules].each_with_index do |mod, row_idx| %>
                <tr>
                  <td><strong><%= mod.name %></strong></td>
                  <% is_dimmed = false %>
                  <% mod.statuses.each_with_index do |st_obj, col_idx| %>
                    <% 
                       status = st_obj[:status]
                       diff = st_obj[:diff]
                       src_sha = st_obj[:src_sha]
                       dst_sha = st_obj[:dst_sha]
                       status_str = status.to_s
                       badge_id = "badge-#{flow[:id]}-#{row_idx}-#{col_idx}"
                       diff_id = "diff-#{flow[:id]}-#{row_idx}-#{col_idx}"
                    %>
                    <td<%= ' class="dimmed"' if is_dimmed %>>
                      <% if diff && !diff.empty? %>
                        <span id="<%= badge_id %>" 
                              class="status-badge clickable" 
                              style="background-color: <%= colors[status_str] %>"
                              data-flow-id="<%= flow[:id] %>"
                              data-project="<%= mod.name %>"
                              data-src-sha="<%= src_sha %>"
                              data-dst-sha="<%= dst_sha %>"
                              data-status="<%= status_str %>"
                              onclick="openModal('<%= badge_id %>', '<%= diff_id %>')">
                          <%= STATUS_LABELS[status_str] || status_str.capitalize %>
                        </span>
                        <div id="<%= diff_id %>" style="display:none"><%= CGI.escapeHTML(diff) %></div>
                      <% else %>
                        <span class="status-badge" 
                              style="background-color: <%= colors[status_str] %>"
                              data-flow-id="<%= flow[:id] %>"
                              data-status="<%= status_str %>">
                          <%= STATUS_LABELS[status_str] || status_str.capitalize %>
                        </span>
                      <% end %>
                    </td>
                    <% 
                       is_dimmed = true if ['behind', 'diverged', 'error'].include?(status_str) 
                    %>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <div id="diffModal" class="modal">
        <div class="modal-content">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0;">Git Diff</h3>
            <span class="close" onclick="closeModal()">&times;</span>
          </div>
          <pre id="modalText"></pre>
          <div class="modal-footer">
            <button class="btn btn-primary" onclick="ignoreDiff()">Ignore diff</button>
            <button class="btn btn-secondary" onclick="ackDiff()">Ack diff</button>
          </div>
        </div>
      </div>

      <script>
        const STATUS_COLORS = <%= config['status_colors'].to_json %>;
        const STATUS_LABELS = <%= STATUS_LABELS.to_json %>;
        const modal = document.getElementById("diffModal");
        const modalText = document.getElementById("modalText");
        const searchInput = document.getElementById('searchInput');
        const hideMergedCheckbox = document.getElementById('hideMerged');
        let currentBadgeId = null;
        let currentFlowId = "<%= flows_data.first[:id] %>";

        function getCacheKey(badge) {
          return `ignore_${badge.dataset.flowId}_${badge.dataset.project}_${badge.dataset.srcSha}_${badge.dataset.dstSha}`;
        }

        function switchTab(flowId) {
          currentFlowId = flowId;
          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.flowId === flowId);
          });
          document.querySelectorAll('.tab-panel').forEach(panel => {
            panel.classList.toggle('active', panel.dataset.flowId === flowId);
          });
          window.location.hash = `flow-${flowId}`;
          filterRows();
        }

        function openModal(badgeId, diffId) {
          const diffContent = document.getElementById(diffId).textContent;
          modalText.textContent = diffContent;
          currentBadgeId = badgeId;
          modal.style.display = "block";
        }

        function closeModal() {
          modal.style.display = "none";
          currentBadgeId = null;
        }

        function applyIgnoredState(badge) {
          badge.classList.add('ignored');
          badge.textContent = 'Ignored';
        }

        function ignoreDiff() {
          if (!currentBadgeId) return;
          
          const badge = document.getElementById(currentBadgeId);
          if (badge) {
            const key = getCacheKey(badge);
            localStorage.setItem(key, 'true');
            applyIgnoredState(badge);
            
            const tr = badge.closest('tr');
            if (tr) updateRowDimming(tr);
            updateTabBadge(badge.dataset.flowId);
            filterRows();
          }
          closeModal();
        }

        function ackDiff() {
          if (!currentBadgeId) return;
          
          const badge = document.getElementById(currentBadgeId);
          if (badge) {
            const key = getCacheKey(badge);
            localStorage.removeItem(key);

            badge.classList.remove('ignored');
            const status = badge.dataset.status;
            badge.textContent = STATUS_LABELS[status] || status;
            
            const tr = badge.closest('tr');
            if (tr) updateRowDimming(tr);
            updateTabBadge(badge.dataset.flowId);
            filterRows();
          }
          closeModal();
        }

        function resetIgnored() {
          const activePanel = document.querySelector(`.tab-panel[data-flow-id="${currentFlowId}"]`);
          const flowName = activePanel ? activePanel.dataset.flowName : currentFlowId;
          if(!confirm(`Reset all ignored diffs for workflow "${flowName}"?`)) return;
          
          const prefix = `ignore_${currentFlowId}_`;
          const keysToRemove = [];
          for(let i=0; i<localStorage.length; i++) {
            const key = localStorage.key(i);
            if(key && key.startsWith(prefix)) {
              keysToRemove.push(key);
            }
          }
          keysToRemove.forEach(k => localStorage.removeItem(k));
          location.reload();
        }

        function updateRowDimming(tr) {
          const badges = Array.from(tr.querySelectorAll('.status-badge'));
          let isDimmed = false;

          badges.forEach(badge => {
            const td = badge.closest('td');
            if (isDimmed) {
              td.classList.add('dimmed');
            } else {
              td.classList.remove('dimmed');
            }

            const isIgnored = badge.classList.contains('ignored');
            const statusText = badge.textContent.trim().toLowerCase();
            
            if (!isIgnored && ['behind', 'diverged', 'error'].includes(statusText)) {
              isDimmed = true;
            }
          });
        }

        function updateTabBadge(flowId) {
          const panel = document.getElementById(`panel-${flowId}`);
          if (!panel) return;
          const badgeEl = document.getElementById(`tab-badge-${flowId}`);
          if (!badgeEl) return;

          const rows = Array.from(panel.querySelectorAll('tbody tr'));
          let issuesCount = 0;
          rows.forEach(row => {
            const badges = Array.from(row.querySelectorAll('.status-badge'));
            const hasIssue = badges.some(b => {
              const s = b.textContent.trim().toLowerCase();
              const isIgnored = b.classList.contains('ignored');
              return !isIgnored && ['behind', 'diverged', 'error'].includes(s);
            });
            if (hasIssue) issuesCount++;
          });

          if (issuesCount > 0) {
            badgeEl.textContent = issuesCount;
            badgeEl.className = 'tab-badge';
            badgeEl.style.display = 'inline-block';
          } else {
            badgeEl.textContent = '0';
            badgeEl.className = 'tab-badge clean';
            badgeEl.style.display = 'inline-block';
          }
        }

        function updateAllTabBadges() {
          document.querySelectorAll('.tab-panel').forEach(panel => {
            updateTabBadge(panel.dataset.flowId);
          });
        }

        function filterRows() {
          const activePanel = document.querySelector(`.tab-panel[data-flow-id="${currentFlowId}"]`);
          if (!activePanel) return;

          const term = searchInput.value.toLowerCase();
          const hideMerged = hideMergedCheckbox.checked;
          const rows = Array.from(activePanel.querySelectorAll('tbody tr'));

          rows.forEach(row => {
            const name = row.cells[0].textContent.toLowerCase();
            const matchesSearch = name.includes(term);
            const badges = Array.from(row.querySelectorAll('.status-badge'));
            const hasIssue = badges.some(b => {
              const s = b.textContent.trim().toLowerCase();
              const isIgnored = b.classList.contains('ignored');
              return !isIgnored && ['behind', 'diverged', 'error'].includes(s);
            });
            
            let visible = matchesSearch;
            if (hideMerged && !hasIssue) visible = false;
            row.style.display = visible ? '' : 'none';
          });
        }

        window.onclick = function(event) {
          if (event.target == modal) closeModal();
        }

        window.addEventListener('keydown', function(event) {
          if (modal.style.display === "block") {
            if (event.key.toLowerCase() === 'i') {
              ignoreDiff();
              event.preventDefault();
            } else if (event.key === 'Escape') {
              closeModal();
            }
          }
        });

        document.addEventListener('DOMContentLoaded', () => {
          // 1. Restore ignored states from localStorage
          const badges = document.querySelectorAll('.status-badge[data-src-sha]');
          badges.forEach(badge => {
            const key = getCacheKey(badge);
            if (localStorage.getItem(key) === 'true') {
               applyIgnoredState(badge);
            }
          });

          // 2. Initialize row dimming for all tables
          document.querySelectorAll('tbody tr').forEach(row => updateRowDimming(row));

          // 3. Compute tab badges
          updateAllTabBadges();

          // 4. Handle URL hash for initial tab selection
          const hash = window.location.hash;
          if (hash && hash.startsWith('#flow-')) {
            const targetFlow = hash.replace('#flow-', '');
            if (document.getElementById(`panel-${targetFlow}`)) {
              switchTab(targetFlow);
            }
          }

          searchInput.addEventListener('input', filterRows);
          hideMergedCheckbox.addEventListener('change', filterRows);
          filterRows();

          // Table column sorting per table
          document.querySelectorAll('th').forEach((th) => {
            th.style.cursor = 'pointer';
            th.addEventListener('click', () => {
              const table = th.closest('table');
              const tbody = table.querySelector('tbody');
              const index = Array.from(th.parentElement.children).indexOf(th);
              const currentRows = Array.from(tbody.querySelectorAll('tr'));
              const multiplier = th.dataset.order === 'asc' ? -1 : 1;
              th.dataset.order = th.dataset.order === 'asc' ? 'desc' : 'asc';
              currentRows.sort((a, b) => a.cells[index].textContent.trim().localeCompare(b.cells[index].textContent.trim()) * multiplier);
              tbody.append(...currentRows);
            });
          });
        });
      </script>
    </body>
    </html>
  ERB
  ERB.new(template).result(binding)
end

# --- Main CLI ---

$options = {
  output: 'package_dashboard.html',
  open: false,
  flows: [],
  all_flows: false,
  add_flow: nil,
  quiet: false
}

OptionParser.new do |opts|
  opts.banner = "Usage: package_status_dashboard [options] [REPO_PATHS...]"

  opts.on("-o", "--output FILE", "Specify output HTML file (default: package_dashboard.html)") do |f|
    $options[:output] = f
  end

  opts.on("--open", "Open the generated dashboard with xdg-open") do
    $options[:open] = true
  end

  opts.on("-q", "--quiet", "Suppress all information messages") do
    $options[:quiet] = true
  end

  opts.on("--flow NAME", "Select flow(s) to use (comma-separated or multiple flags; 'all' for all flows)") do |name|
    $options[:flows].concat(name.split(',').map(&:strip))
  end

  opts.on("--all-flows", "Analyze all configured flows") do
    $options[:all_flows] = true
  end

  opts.on("--add-flow DEFINITION", "Add a new flow to config (Format: id:name:stage1:stage2:...)") do |definition|
    $options[:add_flow] = definition
  end

  opts.on("-h", "--help", "Prints this help") do
    puts opts
    puts
    puts "Description:"
    puts "  This tool tracks the git sync status of packages across multiple workflow stages."
    puts "  It supports git submodules or standalone repositories."
    puts "  The status (synced, merged, behind, diverged) is visualized in an HTML dashboard."
    puts
    puts "  Configuration is stored in $XDG_CONFIG_HOME/suse-dashboard.yaml"
    puts "  You can define multiple 'flows' (sequences of branches) in the config."
    exit
  end
end.parse!

config = load_config

# Handle --add-flow
if $options[:add_flow]
  parts = $options[:add_flow].split(':')
  if parts.length < 4
    puts "Error: Invalid flow definition. Format must be 'id:name:stage1:stage2...'"
    exit 1
  end
  
  flow_id = parts[0]
  flow_name = parts[1]
  stages = parts[2..-1]

  config['flows'][flow_id] = {
    'name' => flow_name,
    'stages' => stages
  }
  save_config(config)
  log_info "Flow '#{flow_id}' (#{flow_name}) added successfully."
  exit 0
end

# Determine flows to use
selected_flow_ids = if $options[:all_flows] || $options[:flows].include?('all')
                      config['flows'].keys
                    elsif $options[:flows].any?
                      $options[:flows].uniq
                    else
                      Array(config['default_flow'])
                    end

if selected_flow_ids.empty?
  puts "Error: No flows selected and no default_flow configured."
  exit 1
end

# Validate all selected flows exist and have proper structure
selected_flow_ids.each do |fid|
  unless config['flows'].key?(fid)
    puts "Error: Flow '#{fid}' not found in configuration."
    puts "Available flows: #{config['flows'].keys.join(', ')}"
    exit 1
  end

  flow_cfg = config['flows'][fid]
  unless flow_cfg.is_a?(Hash) && flow_cfg['stages'].is_a?(Array) && flow_cfg['stages'].length >= 2
    puts "Error: Flow '#{fid}' must be configured with a 'name' and at least 2 'stages'."
    exit 1
  end
end

# Determine repositories to scan
repo_paths = ARGV.empty? ? (config['repos'] || ['.']) : ARGV

target_packages = discover_modules(repo_paths)

if target_packages.empty?
  log_info "No packages or repositories found to process."
  exit 0
end

log_info "Discovered #{target_packages.length} package(s) to analyze."

excludes = config['excludes']
flows_data = []

selected_flow_ids.each do |flow_id|
  flow_cfg = config['flows'][flow_id]
  flow_name = flow_cfg['name'] || flow_id
  stages = flow_cfg['stages']

  log_info "Analyzing workflow '#{flow_name}' (#{stages.join(' -> ')})..."
  modules = target_packages.map do |pkg|
    analyze_module(pkg[:name], pkg[:path], stages, excludes)
  end

  flows_data << {
    id: flow_id,
    name: flow_name,
    stages: stages,
    modules: modules
  }
end

output_file = File.expand_path($options[:output])
File.write(output_file, generate_html(flows_data, config))
log_info "Dashboard generated at: #{output_file}"

if $options[:open] || config['open_by_default']
  system("xdg-open #{output_file}")
end
